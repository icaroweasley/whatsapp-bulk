generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  password         String
  instances        String       // Comma separated list of instances
  planStatus       String       @default("inactive") // "active", "inactive", "pending"
  planExpiresAt    DateTime?
  customPrice      Float?       // Preço negociado internamente com o cliente
  mpCustomerId     String?      // Mercado Pago Payment ID or Customer ID
  lastActiveInstance String?    // Sincronização entre dispositivos da última instância selecionada
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lists            SavedList[]
  dailyUsage       DailyUsage[]
}

model SavedList {
  id        String   @id @default(uuid())
  name      String
  contacts  String   // JSON string of contacts
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyUsage {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @db.Date // Store just the date part (e.g. 2026-05-27)
  messageCount     Int      @default(0)
  contactedNumbers String[] @default([])
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // Ensure only one record per user per day
}
